{
  "name": "nilgriri-performance",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test:run": "node run-tests.js",
    "test:influx": "USE_INFLUX=true node run-tests.js",
    "smoke": "node run-tests.js smoke.js",
    "smoke:influx": "USE_INFLUX=true node run-tests.js smoke.js",
    "all": "node run-tests.js all",
    "all:influx": "USE_INFLUX=true node run-tests.js all",
    "monitor:start": "docker-compose up -d",
    "monitor:stop": "docker-compose down",
    "monitor:logs": "docker-compose logs -f",
    "monitor:status": "docker-compose ps",
    "monitor:restart": "docker-compose restart"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.943.0",
    "@aws-sdk/types": "^3.936.0",
    "dotenv": "^17.2.3",
    "performancenilgiri": "^0.0.9",
    "create-testperformance": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/dotenv": "^6.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
    
  }
}
